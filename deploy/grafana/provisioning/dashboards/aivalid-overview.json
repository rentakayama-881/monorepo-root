      "title": "Error Rate (5xx)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"go-backend\",status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"go-backend\"}[5m]))",
          "legendFormat": "Go Backend",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_request_duration_seconds_count{job=\"feature-service\",code=~\"5..\"}[5m])) / sum(rate(http_request_duration_seconds_count{job=\"feature-service\"}[5m]))",
          "legendFormat": "Feature Service",
          "refId": "B"
        }
      ]
    },
