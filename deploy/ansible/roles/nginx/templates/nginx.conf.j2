# ==============================================================================
# AIValid — Nginx site configuration (Jinja2 template)
# ==============================================================================
# Generated by Ansible from roles/nginx/templates/nginx.conf.j2
# Based on deploy/nginx/aivalid.conf with security headers and rate limiting.
#
# Host nginx terminates SSL and proxies to local systemd services via localhost.
# ==============================================================================

# Rate limiting zone
limit_req_zone $binary_remote_addr zone=api:10m rate={{ nginx_rate_limit_rate }};

# =========================================================================
# HTTP → HTTPS redirect (all domains)
# =========================================================================
server {
    listen 80;
    server_name {{ domain_api }} {{ domain_feature }} {{ domain_grafana }};

    # ACME challenge for cert renewal (certbot webroot)
    location /.well-known/acme-challenge/ {
        root {{ acme_webroot }};
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# =========================================================================
# Go Backend — {{ domain_api }}
# =========================================================================
server {
    listen 443 ssl;
    http2 on;
    server_name {{ domain_api }};

    # SSL — Let's Encrypt certs
    ssl_certificate     {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Include Let's Encrypt recommended settings if available
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Defense-in-depth security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    proxy_hide_header X-Powered-By;
    server_tokens off;

    # ACME challenge
    location /.well-known/acme-challenge/ {
        root {{ acme_webroot }};
    }

    location / {
        limit_req zone=api burst={{ nginx_rate_limit_burst }} nodelay;

        proxy_pass http://127.0.0.1:{{ upstream_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_cache_bypass $http_upgrade;
    }
}

