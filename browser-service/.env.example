# Browser Service Configuration
HOST=0.0.0.0
PORT=6100
LOG_LEVEL=info

# JWT (same secret as Feature Service)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# Feature Service (internal API)
FEATURE_SERVICE_URL=http://127.0.0.1:5000
FEATURE_SERVICE_TOKEN=change-me

# Browser session limits
MAX_CONCURRENT_GLOBAL=50
VNC_PORT_RANGE_START=6200
VNC_PORT_RANGE_END=6299
BROWSER_PROFILES_DIR=/opt/alephdraad/browser-service/profiles
SCREENSHOT_DIR=/opt/alephdraad/browser-service/screenshots

# Billing
BILLING_INTERVAL_SECONDS=60
